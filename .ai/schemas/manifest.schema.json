{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SystemManifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "system": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "architecture",
        "version"
      ]
    },
    "canonical": {
      "type": "object"
    },
    "platforms": {
      "type": "object"
    },
    "validation": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "system",
    "canonical",
    "platforms"
  ]
}
